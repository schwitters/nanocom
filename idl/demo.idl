module demo {

  /**
   * @brief Logger interface.
   *
   * The logger is reference-counted via i_unknown.
   * Implementations define the meaning/range of @p level.
   */
  [uuid("993c054c-927a-4aac-9914-efaa9082efeb")]
  interface i_logger : i_unknown {

    /**
     * @brief Log a message.
     *
     * @param level Severity/level (application-defined).
     * @param msg NUL-terminated UTF-8 message string.
     */
    void log(in int level, in const char *msg);
  };
  /**
   * @brief Clock interface.
   *
   * Provides access to the current UNIX time in milliseconds.
   * Inherits reference counting and query_interface from i_unknown.
   */
  [uuid("e66873f3-0e9c-40ec-bc2a-aea32cee371c")]
  interface i_clock : i_unknown {

    /**
     * @brief Get current UNIX time in milliseconds.
     *
     * @param out_ms Receives the current time as milliseconds since UNIX epoch.
     * @return status_t Success or failure code.
     */
    status_t now_unix_ms(out int64 out_ms);
  };
  [uuid("d4671b09-cdb2-4f1a-b767-d0aedf041b93")]
  interface i_clock2 : i_clock {

    /**
     * @brief Get current UNIX time in milliseconds.
     *
     * @param out_ms Receives the current time as milliseconds since UNIX epoch.
     * @param out_err Optional. Receives an i_error_info object on failure (or additional info),
     *                AddRef'ed for the caller. May be NULL if no detail is available.
     *
     * Ownership:
     * - If out_err is non-NULL and an error object is returned, the caller must release it.
     *
     * @return status_t Success or failure code.
     */
    status_t now_unix_ms(out int64 out_ms, [optional] out i_error_info out_err);
  };
};